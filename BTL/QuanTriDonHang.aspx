<%@ Page Title="Quản trị đơn hàng" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="QuanTriDonHang.aspx.cs" Inherits="ShoeStore.QuanTriDonHang" %>
<%@ Register Src="~/Controls/TabQuanTri.ascx" TagPrefix="uc" TagName="TabQuanTri" %>
<asp:Content ID="Head" ContentPlaceHolderID="HeadContent" runat="server"><link rel="stylesheet" href="Content/css/quantri.css" /></asp:Content>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server">
<section class="admin-page"><h1>Quản trị đơn hàng</h1><uc:TabQuanTri ID="ucTabs" runat="server" ActiveTab="orders" />
<div class="admin-toolbar"><asp:TextBox ID="txtSearch" runat="server" CssClass="o-nhap" placeholder="Mã đơn, khách hàng hoặc số điện thoại" /><asp:Button ID="btnSearch" runat="server" Text="Tìm kiếm" CssClass="nut" OnClick="btnSearch_Click" /></div>
<asp:Literal ID="litMessage" runat="server" /><div class="admin-table-wrap"><asp:GridView ID="gvOrders" runat="server" AutoGenerateColumns="false" DataKeyNames="Id" CssClass="admin-table" OnRowCommand="gvOrders_RowCommand" EmptyDataText="Chưa có đơn hàng nào.">
<Columns><asp:BoundField DataField="Code" HeaderText="Mã đơn" /><asp:BoundField DataField="CreatedAt" HeaderText="Ngày đặt" DataFormatString="{0:dd/MM/yyyy HH:mm}" /><asp:BoundField DataField="CustomerName" HeaderText="Khách hàng" /><asp:BoundField DataField="Phone" HeaderText="Điện thoại" /><asp:BoundField DataField="Total" HeaderText="Tổng tiền" DataFormatString="{0:N0} đ" /><asp:BoundField DataField="Status" HeaderText="Trạng thái" />
<asp:TemplateField HeaderText="Cập nhật trạng thái"><ItemTemplate><asp:DropDownList ID="ddlStatus" runat="server"><asp:ListItem>Chờ xác nhận</asp:ListItem><asp:ListItem>Đang giao</asp:ListItem><asp:ListItem>Đã giao</asp:ListItem><asp:ListItem>Đã hủy</asp:ListItem></asp:DropDownList><asp:LinkButton runat="server" Text="Lưu" CommandName="SaveStatus" CommandArgument='<%# Eval("Id") %>' CssClass="nut-link" /></ItemTemplate></asp:TemplateField>
</Columns></asp:GridView></div></section></asp:Content>
