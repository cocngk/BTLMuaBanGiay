
<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ShoeStore.SiteMaster" %>
<%@ Register Src="~/Controls/SearchBox.ascx" TagPrefix="uc" TagName="SearchBox" %>
<%@ Import Namespace="ShoeStore.Models" %>
<%@ Import Namespace="ShoeStore.Helpers" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>SneakerX - Giày Dép Chính Hãng</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Icon + font đều nằm trong project: không gọi ra ngoài, chạy được khi offline -->
    <link rel="stylesheet" href="Content/vendor/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="Content/fonts/fonts.css" />
    <link rel="stylesheet" href="Content/charm-tokens.css" />
    <link rel="stylesheet" href="Content/site.css" />

    

    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" />

        <header class="header-container">
            <a href="TrangChu.aspx" class="logo-area">
                <div class="logo-icon">
                    <i class="fa-solid fa-shoe-prints"></i>
                </div>
                <span class="logo-text">SneakerX</span>
            </a>

            <ul class="nav-center">
                <asp:Repeater ID="rptMenu" runat="server">
                    <ItemTemplate>
                        <li class="nav-item">
                            <a href='<%# Eval("Url") %>' class='<%# (bool)Eval("IsActive") ? "active" : "" %>'>
                                <i class='<%# Eval("IconClass") %>'></i> <%# Eval("Title") %>
                            </a>
                        </li>
                    </ItemTemplate>
                </asp:Repeater>
            </ul>

            <div class="header-right">
                <uc:SearchBox ID="ucHeaderSearch" runat="server" />

                <a href="GioHang.aspx" id="cartIcon" runat="server" class="cart-icon-btn" title="Giỏ hàng">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span id="cartCount" runat="server" class="cart-count" visible="false"></span>
                </a>

                <asp:Panel ID="pnlGuest" runat="server" CssClass="auth-buttons-group">
                    <a href="DangNhap.aspx" class="btn-header-login">
                        <i class="fa-solid fa-user"></i> Đăng nhập
                    </a>

                    <a href="DangKy.aspx" class="btn-header-register">
                        <i class="fa-solid fa-user-plus"></i> Đăng ký
                    </a>
                </asp:Panel>

                <asp:Panel ID="pnlUser" runat="server" CssClass="user-logged-box" Visible="false">
                    <div class="user-avatar-circle">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <span class="user-name-text">
                        <asp:Literal ID="litUsername" runat="server"></asp:Literal>
                    </span>

                    <asp:LinkButton
                        ID="btnLogout"
                        runat="server"
                        CssClass="btn-logout-icon"
                        OnClick="btnLogout_Click"
                        CausesValidation="false"
                        title="Đăng xuất">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </asp:LinkButton>
                </asp:Panel>
            </div>
        </header>

        <div class="main-wrapper">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>

        <footer class="footer">
            <div class="footer-inner">
                <div class="footer-col footer-brand-col">
                    <a href="TrangChu.aspx" class="footer-logo">
                        <span class="footer-logo-icon"><i class="fa-solid fa-shoe-prints"></i></span>
                        <span class="footer-logo-text"><%= ShopInfo.BrandName %></span>
                    </a>
                    <p class="footer-tagline"><%= ShopInfo.Tagline %></p>
                    <div class="footer-social">
                        <asp:Repeater ID="rptSocial" runat="server">
                            <ItemTemplate>
                                <a href='<%# Eval("Url") %>' class="footer-social-btn" title='<%# Eval("Label") %>'>
                                    <i class='<%# Eval("IconClass") %>'></i>
                                </a>
                            </ItemTemplate>
                        </asp:Repeater>
                    </div>
                </div>

                <div class="footer-col">
                    <h4 class="footer-heading">Liên kết</h4>
                    <ul class="footer-links">
                        <asp:Repeater ID="rptFooterPages" runat="server">
                            <ItemTemplate>
                                <li><a href='<%# Eval("Url") %>'><%# Eval("Title") %></a></li>
                            </ItemTemplate>
                        </asp:Repeater>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4 class="footer-heading">Hỗ trợ</h4>
                    <ul class="footer-links">
                        <asp:Repeater ID="rptFooterPolicies" runat="server">
                            <ItemTemplate>
                                <li><a href='<%# Eval("Url") %>'><%# Eval("Title") %></a></li>
                            </ItemTemplate>
                        </asp:Repeater>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4 class="footer-heading">Liên hệ</h4>
                    <ul class="footer-contact-list">
                        <li>
                            <i class="fa-solid fa-headset"></i>
                            <span>Hotline <a href="tel:19006789"><%= ShopInfo.Hotline %></a></span>
                        </li>
                        <li>
                            <i class="fa-solid fa-mobile-screen"></i>
                            <span>Zalo <%= ShopInfo.Mobile %></span>
                        </li>
                        <li>
                            <i class="fa-solid fa-envelope"></i>
                            <span><a href="mailto:<%= ShopInfo.Email %>"><%= ShopInfo.Email %></a></span>
                        </li>
                        <li>
                            <i class="fa-solid fa-location-dot"></i>
                            <span><%= ShopInfo.Address %></span>
                        </li>
                        <li>
                            <i class="fa-regular fa-clock"></i>
                            <span><%= ShopInfo.OpeningHours %></span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="footer-newsletter">
                <div class="footer-newsletter-copy">
                    <h4 class="footer-heading">Nhận tin khuyến mãi</h4>
                    <p>Giảm giá theo mùa và thông báo hàng về sớm nhất, không spam.</p>
                </div>
                <div class="footer-newsletter-form">
                    <asp:TextBox ID="txtNewsletterEmail" runat="server" CssClass="footer-newsletter-input"
                        TextMode="Email" placeholder="Email của bạn" />
                    <asp:RequiredFieldValidator ID="reqNewsletterEmail" runat="server" ControlToValidate="txtNewsletterEmail"
                        ErrorMessage="Vui lòng nhập email." CssClass="field-error" Display="Dynamic" ValidationGroup="Newsletter" />
                    <asp:RegularExpressionValidator ID="revNewsletterEmail" runat="server" ControlToValidate="txtNewsletterEmail"
                        ValidationExpression="^[^@\s]+@[^@\s]+\.[^@\s]+$" ErrorMessage="Email chưa đúng định dạng."
                        CssClass="field-error" Display="Dynamic" ValidationGroup="Newsletter" />
                    <asp:Button ID="btnNewsletter" runat="server" Text="Đăng ký" CssClass="footer-newsletter-btn"
                        OnClick="btnNewsletter_Click" ValidationGroup="Newsletter" />
                </div>
            </div>

            <div class="footer-partners">
                <span class="footer-partners-label">Thanh toán &amp; vận chuyển</span>
                <asp:Repeater ID="rptPartners" runat="server">
                    <ItemTemplate>
                        <span class="footer-partner"><%# Container.DataItem %></span>
                    </ItemTemplate>
                </asp:Repeater>
            </div>

            <div class="footer-bottom">
                <p>&copy; <%= ShopInfo.CurrentYear %> <%= ShopInfo.BrandName %>. Tất cả quyền được bảo lưu.</p>
                <p class="footer-credits">
                    Ảnh minh hoạ từ <a href="https://unsplash.com" target="_blank" rel="noopener">Unsplash</a>
                    &middot; danh sách tác giả trong <code>CREDITS.md</code>
                </p>
            </div>
        </footer>

        <!-- NOI HIEN THI THONG BAO -->
        <div id="toastContainer" class="toast-container"></div>

        <!-- HAM TOAST DUNG CHUNG CHO CAC TRANG -->
        <script type="text/javascript">
            function openLoginModal() {
                window.location.href = 'DangNhap.aspx';
            }

            document.addEventListener('DOMContentLoaded', function () {
                // Search: chỉ submit khi chữ khác lúc mở trang;
                // bấm khi chưa gõ/chưa đổi thì focus + bôi đen để sửa
                document.querySelectorAll('.search-pill input, .search-inner input').forEach(function (inp) {
                    inp.dataset.initial = inp.value;
                });
            });

            function headerSearchSubmit(btn) {
                var wrap = null;
                if (btn.closest) {
                    wrap = btn.closest('.search-pill') || btn.closest('.search-inner');
                }
                var input = wrap ? wrap.querySelector('input') : null;
                if (!input) return true;
                var cur = input.value.trim();
                if (cur === '' || cur === (input.dataset.initial || '')) {
                    input.focus();
                    try { input.select(); } catch (e) {}
                    return false;
                }
                return true;
            }

            // Sinh tu Helpers.Money nen client va server luon hien cung khu giá.
            <%= Money.JsFormatter %>

            function showToast(message, type) {
                type = type || 'error';

                var container = document.getElementById('toastContainer');

                if (!container) {
                    return;
                }

                var toast = document.createElement('div');
                toast.className = 'toast-message ' + type;

                var iconClass = 'fa-triangle-exclamation';

                if (type === 'success') {
                    iconClass = 'fa-circle-check';
                } else if (type === 'info') {
                    iconClass = 'fa-circle-info';
                }

                var content = document.createElement('div');
                content.className = 'toast-content';

                var icon = document.createElement('i');
                icon.className = 'fa-solid ' + iconClass;

                var text = document.createElement('span');
                text.textContent = message;

                content.appendChild(icon);
                content.appendChild(text);

                var closeButton = document.createElement('button');
                closeButton.type = 'button';
                closeButton.className = 'btn-close-toast';
                closeButton.textContent = '\u00D7';
                closeButton.setAttribute('aria-label', 'Đóng thông báo');

                closeButton.onclick = function () {
                    if (toast.parentNode) {
                        toast.parentNode.removeChild(toast);
                    }
                };

                toast.appendChild(content);
                toast.appendChild(closeButton);
                container.appendChild(toast);

                setTimeout(function () {
                    if (toast.parentNode) {
                        toast.style.opacity = '0';
                        toast.style.transform = 'translateX(110%)';

                        setTimeout(function () {
                            if (toast.parentNode) {
                                toast.parentNode.removeChild(toast);
                            }
                        }, 300);
                    }
                }, 3500);
            }
        </script>

    </form>
</body>
</html>
