<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="ShoeStore.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>SneakerX - Giày chính hãng</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="Content/site.css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <header class="top">
            <a class="logo" href="TrangChu.aspx">SneakerX</a>

            <nav>
                <a href="TrangChu.aspx">Trang chủ</a>
                <a href="SanPham.aspx">Sản phẩm</a>
                <a href="GioHang.aspx">Giỏ hàng (<asp:Literal ID="litSoGio" runat="server" Text="0" />)</a>
                <a href="TaiKhoan.aspx">Tài khoản</a>
                <asp:PlaceHolder ID="phnQuanTri" runat="server" Visible="false">
                    <a href="QuanTriSanPham.aspx">Quản trị</a>
                </asp:PlaceHolder>
            </nav>

            <div class="thanh-cong-cu">
                <asp:TextBox ID="txtTimKiem" runat="server" CssClass="o-tim" placeholder="Tìm giày..."></asp:TextBox>
                <asp:Button ID="btnTimKiem" runat="server" Text="Tìm" CssClass="nut nho" OnClick="btnTimKiem_Click" />
                <asp:Literal ID="litTaiKhoan" runat="server" />
                <asp:LinkButton ID="btnThoat" runat="server" Text="Thoát" CssClass="nut-link" Visible="false" OnClick="btnThoat_Click" />
            </div>
        </header>

        <main class="khung">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </main>

        <footer class="chan">
            <p>SneakerX - Bài tập lớn môn Lập trình web</p>
            <p>
                Lượt truy cập: <asp:Literal ID="litLuotTruyCap" runat="server" Text="0" />
                &middot; Đang online: <asp:Literal ID="litDangOnline" runat="server" Text="0" />
            </p>
        </footer>

    </form>
</body>
</html>
