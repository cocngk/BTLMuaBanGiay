
<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ShoeStore.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>SneakerX - Giày Dép Chính Hãng</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@700;800&family=Fragment+Mono&family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="Content/charm-tokens.css" />
    <link rel="stylesheet" href="Content/site.css" />

    

    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">

        <header class="header-container">
            <a href="TrangChu.aspx" class="logo-area">
                <div class="logo-icon">
                    <i class="fa-solid fa-shoe-prints"></i>
                </div>
                <span class="logo-text">SneakerX</span>
            </a>

            <ul class="nav-center">
                <li class="nav-item">
                    <a href="TrangChu.aspx" id="navHome" runat="server">
                        <i class="fa-solid fa-house"></i> Trang chủ
                    </a>
                </li>

                <li class="nav-item">
                    <a href="SanPham.aspx" id="navProduct" runat="server">
                        <i class="fa-solid fa-shoe-prints"></i> Sản phẩm
                    </a>
                </li>

                <li class="nav-item">
                    <a href="TinTuc.aspx" id="navNews" runat="server">
                        <i class="fa-solid fa-newspaper"></i> Tin tức
                    </a>
                </li>

                <li class="nav-item">
                    <a href="TuVan.aspx" id="navConsult" runat="server">
                        <i class="fa-solid fa-headset"></i> Tư vấn
                    </a>
                </li>

                <li class="nav-item">
                    <a href="GioHang.aspx" id="navCart" runat="server">
                        <i class="fa-solid fa-bag-shopping"></i> Giỏ hàng
                    </a>
                </li>

                <li class="nav-item">
                    <a href="ThanhToan.aspx" id="navCheckout" runat="server">
                        <i class="fa-solid fa-credit-card"></i> Thanh toán
                    </a>
                </li>
            </ul>

            <div class="header-right">
                <div class="search-pill">
                    <asp:TextBox
                        ID="txtHeaderSearch"
                        runat="server"
                        Placeholder="Tìm giày...">
                    </asp:TextBox>

                    <asp:LinkButton
                        ID="btnHeaderSearch"
                        runat="server"
                        CssClass="btn-search-icon"
                        OnClick="btnHeaderSearch_Click">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </asp:LinkButton>
                </div>

                <a href="GioHang.aspx" class="cart-icon-btn" title="Giỏ hàng">
                    <i class="fa-solid fa-bag-shopping"></i>
                </a>

                <asp:Panel ID="pnlGuest" runat="server" CssClass="auth-buttons-group">
                    <a href="DangNhap.aspx" class="btn-header-login">
                        <i class="fa-solid fa-user"></i> Đăng nhập
                    </a>

                    <a href="DangKy.aspx" class="btn-header-register">
                        <i class="fa-solid fa-user-plus"></i> Đăng ký
                    </a>
                </asp:Panel>

                <asp:Panel ID="pnlUser" runat="server" CssClass="user-logged-box" Visible="false">
                    <div class="user-avatar-circle">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <span class="user-name-text">
                        <asp:Literal ID="litUsername" runat="server"></asp:Literal>
                    </span>

                    <asp:LinkButton
                        ID="btnLogout"
                        runat="server"
                        CssClass="btn-logout-icon"
                        OnClick="btnLogout_Click"
                        CausesValidation="false"
                        title="Đăng xuất">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </asp:LinkButton>
                </asp:Panel>
            </div>
        </header>

        <div class="main-wrapper">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>

        <footer class="footer">
            <p>&copy; 2026 SneakerX. Tất cả quyền được bảo lưu.</p>
        </footer>

        <!-- NOI HIEN THI THONG BAO -->
        <div id="toastContainer" class="toast-container"></div>

        <!-- HAM TOAST DUNG CHUNG CHO CAC TRANG -->
        <script type="text/javascript">
            function openLoginModal() {
                window.location.href = 'DangNhap.aspx';
            }

            function showToast(message, type) {
                type = type || 'error';

                var container = document.getElementById('toastContainer');

                if (!container) {
                    return;
                }

                var toast = document.createElement('div');
                toast.className = 'toast-message ' + type;

                var iconClass = 'fa-triangle-exclamation';

                if (type === 'success') {
                    iconClass = 'fa-circle-check';
                } else if (type === 'info') {
                    iconClass = 'fa-circle-info';
                }

                var content = document.createElement('div');
                content.className = 'toast-content';

                var icon = document.createElement('i');
                icon.className = 'fa-solid ' + iconClass;

                var text = document.createElement('span');
                text.textContent = message;

                content.appendChild(icon);
                content.appendChild(text);

                var closeButton = document.createElement('button');
                closeButton.type = 'button';
                closeButton.className = 'btn-close-toast';
                closeButton.textContent = '\u00D7';
                closeButton.setAttribute('aria-label', 'Đóng thông báo');

                closeButton.onclick = function () {
                    if (toast.parentNode) {
                        toast.parentNode.removeChild(toast);
                    }
                };

                toast.appendChild(content);
                toast.appendChild(closeButton);
                container.appendChild(toast);

                setTimeout(function () {
                    if (toast.parentNode) {
                        toast.style.opacity = '0';
                        toast.style.transform = 'translateX(110%)';

                        setTimeout(function () {
                            if (toast.parentNode) {
                                toast.parentNode.removeChild(toast);
                            }
                        }, 300);
                    }
                }, 3500);
            }
        </script>

    </form>
</body>
</html>
